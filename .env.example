# ---------------------------------------------------------------------------
# TheyWork — copie para `.env` e ajuste conforme o seu hardware.
# Nenhum segredo real deve ser commitado neste arquivo.
# ---------------------------------------------------------------------------

# --- Aplicação -------------------------------------------------------------
APP_NAME=TheyWork
APP_ENV=development
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=theywork
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=theywork
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://theywork:change-me-local-only@postgres:5432/theywork
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# --- Redis -----------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Ollama ----------------------------------------------------------------
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_TIMEOUT_SECONDS=120
# Mantém no máximo 1 modelo carregado em memória — regra da Natureza.
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=5m

# --- A Natureza (limites físicos do hardware alvo) -------------------------
# Teto da empresa. O valor efetivo é min(este, RAM física), e ele também é o denominador
# do percentual de saúde — baixá-lo abaixo da RAM física distorce o ratio, porque o uso
# lido é o da máquina inteira (IDE, navegador, outros containers).
NATURE_RAM_LIMIT_MB=16384
NATURE_VRAM_LIMIT_MB=4096
# Esta é a folga do host: o knob certo para "não deixar a empresa consumir tudo".
# Reserva e limiares protegem o mesmo recurso — o mais restritivo vence. Para que o regime
# de contenção chegue a conceder um modelo por pressão de RAM, em vez de só represar a vaga:
#   NATURE_RESERVED_RAM_MB + 2048 <= (1 - NATURE_WARNING_THRESHOLD) * NATURE_RAM_LIMIT_MB
NATURE_RESERVED_RAM_MB=2048
NATURE_RESERVED_VRAM_MB=512
NATURE_WARNING_THRESHOLD=0.75
NATURE_CRITICAL_THRESHOLD=0.90
NATURE_POLL_INTERVAL_SECONDS=5
NATURE_MAX_CONCURRENT_SUBAGENTS=4
NATURE_MAX_QUEUE_SIZE=32

# --- Observabilidade cognitiva (Fase 3) --------------------------------------
# REASONING_CAPTURE_ENABLED=false mantém a sessão, mas deixa de persistir os passos.
REASONING_CAPTURE_ENABLED=true
# Teto de iterações do ciclo ReAct por tarefa.
REASONING_MAX_STEPS=8
# Eventos enfileirados por assinante WebSocket antes de descartar os mais antigos.
REASONING_STREAM_BUFFER=256
# Corte padrão de POST /reasoning/retention/purge.
REASONING_RETENTION_DAYS=30
REASONING_MAX_CONTENT_CHARS=8000
